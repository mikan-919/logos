{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "isolatedModules": true,
    "strict": false,
    "skipLibCheck": true,
    "types": ["irisout/jsx"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
